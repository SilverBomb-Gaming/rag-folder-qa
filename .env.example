# Local Ollama server. No cloud API key is used.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Chat model for answers. Pull it with: ollama pull llama3.2
OLLAMA_CHAT_MODEL=llama3.2

# Embedding model for ingest and retrieval. Pull it with: ollama pull nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text

# Chunk length and overlap, in characters.
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# How many chunks to retrieve for each question.
TOP_K=4
